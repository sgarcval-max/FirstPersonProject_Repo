  entries:
  - key: menu_resume
    spanish: REANUDAR
    english: RESUME
  - key: menu_settings
    spanish: AJUSTES
    english: SETTINGS
  - key: menu_main_menu
    spanish: "SALIR AL MEN\xDA PRINCIPAL"
    english: EXIT TO MAIN MENU
  - key: menu_quit
    spanish: SALIR DEL JUEGO
    english: QUIT GAME
  - key: settings_mouse_keyboard
    spanish: "RAT\xD3N Y TECLADO"
    english: MOUSE AND KEYBOARD
  - key: settings_subtitles
    spanish: SUBTITULOS
    english: SUBTITLES
  - key: tooltip_master_volume
    spanish: "\xB7 Ajusta el volumen general del juego"
    english: "\xB7 Adjusts the game's overall volume"
  - key: tooltip_music_volume
    spanish: "\xB7 Ajusta el volumen de la m\xFAsica del juego"
    english: "\xB7 Adjust the game music volume"
  - key: tooltip_sfx_volume
    spanish: "\xB7 Ajusta el volumen de los efectos de sonido del juego."
    english: "\xB7 Adjusts the game's sound effect volume."
  - key: SoundButton
    spanish: SONIDO
    english: SOUND
  - key: RyTButton
    spanish: "RAT\xD3N Y TECLADO"
    english: MOUSE AND KEYBOARD
  - key: InfoAjustes
    spanish: AJUSTES
    english: SETTINGS
  - key: Tooltip_soundButton
    spanish: "\xB7 Este men\xFA contiene opciones para ajustar el volumen, la musica
      y los efectos"
    english: "\xB7 This menu contains options to adjust the volume, music, and effects."
  - key: Tooltip_RyTButton
    spanish: "\xB7 Este men\xFA contiene opciones para modificar los controles del
      raton y teclado"
    english: "\xB7 This menu contains options to modify mouse and keyboard controls."
  - key: Tooltip_SubButton
    spanish: "\xB7 Este men\xFA contiene opciones para modificar el idioma del juego"
    english: "\xB7 This menu contains options to change the game language."
  - key: Subinfotext
    spanish: "AJUSTES DE SUBT\xCDTULOS"
    english: SUBTITLE SETTINGS
  - key: iDIOMAteXT
    spanish: IDIOMA DE LOS TEXTOS
    english: LANGUAGE OF THE TEXTS
  - key: iNFOajustessound
    spanish: AJUSTES SONIDO
    english: SOUND SETTINGS
  - key: VOLUMENinfo
    spanish: VOLUMEN
    english: VOLUME
  - key: VOLUMEN_GENERAL
    spanish: VOLUMEN GENERAL
    english: GENERAL VOLUME
  - key: MUSICA_
    spanish: MUSICA
    english: MUSIC
  - key: EFECTOS_
    spanish: EFECTOS
    english: EFFECTS
  - key: ASIGNA_TEXT
    spanish: "ASIGNACI\xD3N DE TECLAS"
    english: KEY ASSIGNMENT
  - key: iNVERT_TEXT
    spanish: INVERTIR EJE Y
    english: REVERSE Y-AXIS
  - key: Tooltip_Slider
    spanish: "\xB7 Ajusta la sensibilidad del rat\xF3n"
    english: "\xB7 Adjust mouse sensitivity"
  - key: Tooltip_Teclas
    spanish: "\xB7 Cambiar la asignaci\xF3n de teclas para rat\xF3n y teclado"
    english: "\xB7 Change key assignments for mouse and keyboard"
  - key: sensi
    spanish: SENSIBILIDAD
    english: SENSITIVITY
  - key: iNFOTEXTGRANDE
    spanish: "AJUSTES DE RAT\xD3N Y TECLADO"
    english: MOUSE AND KEYBOARD SETTINGS
  - key: iNFOSUBTEXT
    spanish: "RAT\xD3N"
    english: MOUSE
  - key: Tooltip_Invert
    spanish: "\xB7 Invierte los ejes del rat\xF3n."
    english: "\xB7 Inverts the mouse axes."
  - key: Play_Game
    spanish: JUGAR
    english: PLAY
  - key: Ajustes_mainmenu
    spanish: AJUSTES
    english: SETTINGS
  - key: ExitGame_mainmenu
    spanish: SALIR DEL JUEGO
    english: EXIT GAME
  - key: Info_teclas
    spanish: "ASIGNACI\xD3N DE TECLAS"
    english: KEY ASSIGNMENT
  - key: MiniInfoTExt_teclas
    spanish: MOVIMIENTO
    english: MOVEMENT
  - key: Exit_Text
    spanish: SALIR AL ESCRITORIO
    english: EXIT TO DESKTOP
  - key: Info_textExit
    spanish: "\xBFSeguro que quieres salir al escritorio?"
    english: Are you sure you want to go to the desk?
  - key: Exit_Button
    spanish: CONFIRMAR
    english: CONFIRM
  - key: Cancel_Button
    spanish: CANCELAR
    english: CANCEL
  - key: weapon_hands
    spanish: MANOS
    english: HANDS
  - key: weapon_pistol
    spanish: PISTOLA
    english: PISTOL
